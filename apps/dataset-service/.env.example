# Server
PORT=4004
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql://airesearch:airesearch_dev_password@localhost:5432/airesearch

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=airesearch
S3_SECRET_ACCESS_KEY=airesearch_dev_password
S3_BUCKET=datasets
S3_REGION=us-east-1

# JWT (for authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000"]
