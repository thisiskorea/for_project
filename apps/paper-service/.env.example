# Server
PORT=4003
ENVIRONMENT=development

# MongoDB
MONGODB_URL=mongodb://airesearch:airesearch_dev_password@localhost:27017/airesearch?authSource=admin

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=airesearch
S3_SECRET_ACCESS_KEY=airesearch_dev_password
S3_BUCKET=papers
S3_REGION=us-east-1

# JWT (for authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# OpenAI (for AI summaries)
OPENAI_API_KEY=your-openai-api-key
